month = int(input("Введите номер месяца "))

match month:
    case 12 | 1 | 2:
        print(f"Номер месяца:{month}, сезон:зима ❄️")
    case 3 | 4 | 5:
        print(f"Номер месяца:{month}, сезон:весна 🌿️")
    case 6 | 7 | 8:
        print(f"Номер месяца:{month}, сезон:лето ☀️️")
    case 9 | 10 | 11:
        print(f"Номер месяца:{month}, сезон:осень 🍂️")
    case _:
        print("Введено неверное число")
