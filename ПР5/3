USD_TO_RUB = 95.50
def convert_usd_to_rub(amount_usd):
    """
    Переводит доллары в рубли
    :param
        amount_usd:
    :return:
        amount_rub
    """
    amount_rub=amount_usd*USD_TO_RUB
    return amount_rub

amount_usd=float(input("Введите кол-во долларов: "))

print(f"Кол-во рублей {convert_usd_to_rub(amount_usd):.2f}")
