import math

def calculate_rectangle_area(width, height):
    """
    Вычисляет площадь прямоугольника
    :param
        width
        height
    :return
        square
    """
    square=width*height
    return square
def calculate_circle_area(radius):
    """
    Вычисляет площадь круга
    :param
        radius
    :return
        cir_square
    """
    cir_square=math.pi*(radius**2)
    return cir_square

width,height = map(float,input("Введите ширину и высоту прямоугольника: ").split())
print(f"Площадь прямоугольника равна {calculate_rectangle_area(width,height)}")
radius=float(input("Введите радиус круга: "))
print(f"Площадь круга равен {calculate_circle_area(radius)}")
